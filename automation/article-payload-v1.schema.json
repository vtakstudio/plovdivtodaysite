{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlovdivToday Article Payload v1",
  "description": "One article per call. story_key/title/content are required on every call; excerpt/category additionally required when creating a new article. Omitted update fields retain values. Only native text Portable Text blocks are accepted in v1; no conversion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "story_key",
    "title",
    "content"
  ],
  "properties": {
    "story_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "_type",
          "_key",
          "children"
        ],
        "properties": {
          "_type": {
            "const": "block"
          },
          "_key": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "enum": [
              "normal",
              "h1",
              "h2",
              "h3",
              "h4",
              "h5",
              "h6",
              "blockquote"
            ]
          },
          "markDefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "_type",
                "_key",
                "href"
              ],
              "properties": {
                "_type": {
                  "const": "link"
                },
                "_key": {
                  "type": "string",
                  "minLength": 1
                },
                "href": {
                  "type": "string",
                  "pattern": "^(https?://|mailto:|/[^/]|#)"
                }
              }
            }
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "_type",
                "_key",
                "text"
              ],
              "properties": {
                "_type": {
                  "const": "span"
                },
                "_key": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "marks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "listItem": {
            "enum": [
              "bullet",
              "number"
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1
          }
        },
        "if": {
          "required": [
            "listItem"
          ]
        },
        "then": {
          "required": [
            "level"
          ]
        }
      }
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        {
          "type": "null"
        }
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "breaking": {
      "type": "boolean"
    },
    "featured_image": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "id",
            "provider"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "provider": {
              "type": "string"
            },
            "alt": {
              "type": "string"
            },
            "meta": {
              "type": "object"
            }
          }
        }
      ]
    },
    "publish_mode": {
      "enum": [
        "draft",
        "publish"
      ],
      "default": "draft"
    }
  }
}
