{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "plovdivtodaysite",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"vars": { "EMDASH_SITE_URL": "https://plovdivtodaysite.estudio-5ba.workers.dev" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "plovdivtodaydb","database_id": "e7d243fc-4104-442e-8bb0-cee1ce3fff87",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "plovdivtodayr2","preview_bucket_name": "plovdivtodayr2",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
