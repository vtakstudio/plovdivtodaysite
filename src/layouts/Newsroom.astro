---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	content?: { collection: string; id: string; slug: string };
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	breadcrumbs?: { name: string; url: string }[];
}
const props = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(), getMenuWithCacheHint("primary", { locale: "bg" }),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint); Astro.cache.set(menuResult.cacheHint);
}
const settings = settingsResult.data;
const siteTitle = settings.title || "PlovdivToday";
const fullTitle = props.title.includes(siteTitle) ? props.title : `${props.title} — ${siteTitle}`;
// The native robots setting is the single prelaunch switch for all templates.
const prelaunch = /Disallow:\s*\/(?:\s|$)/.test(settings.seo?.robotsTxt || "");
const siteUrl = settings.url || Astro.url.origin;
const canonical = props.canonical || new URL(Astro.url.pathname, siteUrl).href;
const page = createPublicPageContext({
	Astro, kind: props.content ? "content" : "custom", pageType: props.content ? "article" : "website",
	title: fullTitle, pageTitle: props.pageTitle || props.title,
	description: props.description || settings.tagline,
	canonical, image: props.image, content: props.content,
	seo: { robots: prelaunch ? "noindex, nofollow" : props.robots },
	articleMeta: { publishedTime: props.publishedTime, modifiedTime: props.modifiedTime, author: props.author },
	siteName: siteTitle, siteUrl, breadcrumbs: props.breadcrumbs,
});
if (prelaunch) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const menu = menuResult.data?.items || [];
const headerMenu = [...menu, { url: "/rayoni/", label: "Райони и квартали" }];
const prioritySections = ["/plovdiv/", "/biznes/", "/kultura/"];
const sectionPriority = (url: string) => {
	const index = prioritySections.indexOf(url);
	return index === -1 ? prioritySections.length : index;
};
headerMenu.sort((a, b) => sectionPriority(a.url) - sectionPriority(b.url));
---
<!doctype html>
<html lang="bg">
	<head>
		<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-heading" preload />
		<title>{fullTitle}</title><EmDashHead page={page} />
	</head>
	<body class="newsroom">
		<EmDashBodyStart page={page} />
		<a class="skip-link" href="#main">Към съдържанието</a>
		<header class="masthead">
			<div class="masthead-top wrap">
				<div class="weather-placeholder" aria-label="Времето в Пловдив — температурата предстои">
					<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
					<span aria-hidden="true">—°</span>
				</div>
				<a class="brand" href="/" aria-label={`${siteTitle} — начало`}>
					<img class="brand-skyline" src="/brand/transparent-logo-v2.png" alt={siteTitle} width="2176" height="708" fetchpriority="high" />
				</a>
				<a href="/search" class="masthead-search" aria-label="Търсене в PlovdivToday">
					<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
				</a>
			</div>
			<div class="category-band">
			<nav class="desktop-nav wrap" aria-label="Основна навигация">
				{headerMenu.map((item, index) => <a data-nav-section hidden={index >= 3} href={item.url} aria-current={Astro.url.pathname === item.url ? "page" : undefined}>{item.label}</a>)}
				<details class="nav-more">
					<summary>Още <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg></summary>
					<div class="nav-more-list">
						{headerMenu.map((item, index) => <a hidden={index < 3} href={item.url} aria-current={Astro.url.pathname === item.url ? "page" : undefined}>{item.label}</a>)}
					</div>
				</details>
			</nav>
			</div>
		</header>
		<main id="main" tabindex="-1"><slot /></main>
		<footer class="news-footer">
			<div class="wrap footer-top">
				<div><a href="/" class="footer-brand">{siteTitle}</a><p>{settings.tagline}</p></div>
				<nav aria-label="Навигация в края">{menu.map(item => <a href={item.url}>{item.label}</a>)}<a href="/rayoni/">Райони и квартали</a></nav>
			</div>
			<div class="wrap footer-bottom"><small>© {new Date().getFullYear()} {siteTitle}</small><div class="reserved">За нас · Контакти · Редакционни стандарти · Корекции <small>— предстоят</small></div></div>
		</footer>
		<EmDashBodyEnd page={page} />
	</body>
</html>

<script>
	const nav = document.querySelector<HTMLElement>(".desktop-nav");
	const more = nav?.querySelector<HTMLDetailsElement>(".nav-more");
	if (nav && more) {
		const links = [...nav.querySelectorAll<HTMLAnchorElement>("[data-nav-section]")];
		const overflowLinks = [...more.querySelectorAll<HTMLAnchorElement>(".nav-more-list a")];
		// Measure the actual labels after font loading and whenever the available width changes.
		const fitCategories = () => {
			links.forEach(link => { link.hidden = false; });
			more.hidden = false;
			const widths = links.map(link => link.getBoundingClientRect().width);
			const gap = parseFloat(getComputedStyle(nav).columnGap);
			const fullWidth = widths.reduce((total, width) => total + width, 0) + gap * (links.length - 1);
			let count = links.length;
			if (fullWidth > nav.clientWidth) {
				count = 0;
				let used = more.getBoundingClientRect().width;
				for (const width of widths) {
					if (used + gap + width > nav.clientWidth) break;
					used += gap + width;
					count++;
				}
			}
			links.forEach((link, index) => { link.hidden = index >= count; });
			overflowLinks.forEach((link, index) => { link.hidden = index < count; });
			more.hidden = count === links.length;
			if (more.hidden) more.open = false;
		};
		fitCategories();
		new ResizeObserver(fitCategories).observe(nav);
		void document.fonts.ready.then(fitCategories);
	}
</script>
