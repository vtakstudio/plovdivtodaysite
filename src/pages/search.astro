---
import { search } from "emdash";
import Newsroom from "../layouts/Newsroom.astro";
const query = Astro.url.searchParams.get("q")?.trim() || "";
const results = query ? await search(query, { collections: ["articles"], status: "published", limit: 30 }) : { items: [] };
---
<Newsroom title={query ? `Търсене: ${query}` : "Търсене"} robots="noindex, follow">
  <section class="archive wrap"><h1>Търсене</h1><form method="get" action="/search"><label for="query">Търсете в материалите</label><input id="query" name="q" type="search" value={query} /><button type="submit">Търсене</button></form>
    {query && <p class="empty">{results.items.length ? `Намерени материали: ${results.items.length}` : "Няма намерени материали."}</p>}
    <ul>{results.items.map(item => <li><a href={`/novini/${item.slug}`}>{item.title}</a></li>)}</ul>
  </section>
</Newsroom>
