---
import { decodeSlug, getEmDashEntry, getEmDashCollection, getSiteSettings, getSeoMeta } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Newsroom from "../../layouts/Newsroom.astro";
import StoryCard from "../../components/StoryCard.astro";
import ArticleBlock from "../../components/ArticleBlock.astro";
import { formatDate, imageUrl } from "../../utils/newsroom";
const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const result = await getEmDashEntry("articles", slug, { locale: "bg" });
const article = result.entry;
if (!article) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
const settings = await getSiteSettings();
const origin = settings.url || Astro.url.origin;
const seo = getSeoMeta(article, { siteTitle: settings.title, siteUrl: origin, path: `/novini/${article.id}`, defaultOgImage: imageUrl(article.data.featured_image, origin) || (settings.seo?.defaultOgImage?.url ? new URL(settings.seo.defaultOgImage.url, origin).href : undefined) });
const categories = article.data.terms?.category || [];
const locations = article.data.terms?.location || [];
const related = await getEmDashCollection("articles", { locale: "bg", status: "published", where: categories[0] ? { category: categories[0].slug } : locations[0] ? { location: locations[0].slug } : {}, limit: 4, orderBy: { published_at: "desc" } });
if (Astro.cache?.enabled) Astro.cache.set(related.cacheHint);
const other = related.entries.filter(entry => entry.id !== article.id).slice(0, 3);
const bylines = article.data.bylines || [];
const author = bylines.map(credit => credit.byline.displayName).join(", ") || article.data.byline?.displayName;
const published = article.data.publishedAt;
const modified = article.data.updatedAt;
const showModified = published && modified.getTime() - published.getTime() > 60000;
const breadcrumbs = [{ name: "Начало", url: new URL("/", origin).href }, ...(categories[0] ? [{ name: categories[0].label, url: new URL(`/${categories[0].slug}/`, origin).href }] : []), { name: article.data.title, url: seo.canonical || new URL(`/novini/${article.id}`, origin).href }];
const headings = (article.data.content || []).filter(block => block._type === "block" && block.style === "h2").map(block => ({ id: block._key ? `heading-${block._key}` : undefined, label: Array.isArray(block.children) ? block.children.map((child: { text?: string }) => child.text || "").join("") : "" }));
---
<Newsroom title={seo.title} pageTitle={seo.ogTitle} description={seo.description} image={seo.ogImage} canonical={seo.canonical} robots={seo.robots} content={{ collection: "articles", id: article.data.id, slug }} publishedTime={published?.toISOString()} modifiedTime={modified.toISOString()} author={author} breadcrumbs={breadcrumbs}>
	<article class="wrap article-page">
		<nav class="breadcrumbs" aria-label="Път до материала"><ol>{breadcrumbs.map((item, index) => <li>{index === breadcrumbs.length - 1 ? <span aria-current="page">Материал</span> : <a href={new URL(item.url).pathname}>{item.name}</a>}</li>)}</ol></nav>
		<header class="article-header">
			<div class="article-taxonomies">{categories.map(term => <a href={`/${term.slug}/`}>{term.label}</a>)}{locations.map(term => <a href={`/rayoni/${term.slug}/`}>{term.label}</a>)}</div>
			{article.data.story_key?.startsWith("demo-") && <p class="demo-notice">Примерен материал · Описаното не е реална новина.</p>}
			<h1 {...article.edit.title}>{article.data.title}</h1>
			{article.data.excerpt && <p class="article-standfirst" {...article.edit.excerpt}>{article.data.excerpt}</p>}
			<div class="article-inline-meta">{author && <span>{author}</span>}{published && <time datetime={published.toISOString()}>{formatDate(published)}</time>}{showModified && <span>Обновено: {formatDate(modified)}</span>}</div>
		</header>
		{article.data.featured_image && <figure class:list={["article-figure", { "portrait-figure": article.data.featured_image?.height && article.data.featured_image?.width && article.data.featured_image.height > article.data.featured_image.width }]} {...article.edit.featured_image}><Image image={article.data.featured_image} priority sizes="(min-width: 904px) 840px, calc(100vw - 40px)" />{(article.data.image_caption || article.data.image_credit) && <figcaption>{article.data.image_caption && <span>{article.data.image_caption}</span>}{article.data.image_credit && <span>{article.data.image_credit}{article.data.story_key?.startsWith("demo-") && ["pedestrian.jpg", "street.jpg", "night.jpg", "fountain.jpg"].includes(article.data.featured_image?.filename || "") && <> · <a href="/brand/demo/credits.txt">Автор и лиценз</a></>}</span>}</figcaption>}</figure>}
		<div class="reading-layout">
			<aside class="article-meta" aria-label="Информация за публикацията"><div class="eyebrow">От редакцията</div>{bylines.map(credit => <p><strong>{credit.byline.displayName}</strong>{credit.roleLabel && <span> · {credit.roleLabel}</span>}</p>)}{published && <><div class="eyebrow">Публикувано</div><time datetime={published.toISOString()}>{formatDate(published)}</time></>}{showModified && <><div class="eyebrow">Обновено</div><time datetime={modified.toISOString()}>{formatDate(modified)}</time></>}</aside>
			<div class="article-body" {...article.edit.content}><PortableText value={article.data.content} components={{ block: { h2: ArticleBlock } }} />{(article.data.source_name || article.data.source_url) && <div class="source-block">Източник: {article.data.source_url ? <a href={article.data.source_url} rel="noopener noreferrer">{article.data.source_name || "Оригинален материал"}</a> : article.data.source_name}</div>}</div>
			<aside class="article-gutter" aria-label="В материала">{headings.length > 0 && <><div class="eyebrow">В материала</div><ul>{headings.map(heading => <li>{heading.id ? <a href={`#${heading.id}`}>{heading.label}</a> : heading.label}</li>)}</ul></>}</aside>
		</div>
		{other.length > 0 && <section class="news-section"><div class="section-heading"><h2>По темата</h2></div><div class="story-grid">{other.map(entry => <StoryCard article={entry} />)}</div></section>}
	</article>
</Newsroom>
